<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_payment_receipt_balance_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <h3 class="text-center mt-4 mb-4">
                    <strong>Reçu de Paiement</strong>
                </h3>

                <!-- Infos paiement -->
                <div class="row mb-4">
                    <div class="col-6">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>N° Paiement :</strong></td>
                                <td><span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date :</strong></td>
                                <td><span t-field="o.date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Méthode :</strong></td>
                                <td><span t-field="o.payment_method_id.name"/></td>
                            </tr>
                            <tr t-if="o.ref">
                                <td><strong>Mémo :</strong></td>
                                <td><span t-field="o.ref"/></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td><strong>
                                    <t t-if="o.partner_type == 'customer'">Client :</t>
                                    <t t-if="o.partner_type == 'supplier'">Fournisseur :</t>
                                </strong></td>
                                <td><span t-field="o.partner_id"/></td>
                            </tr>
                            <tr t-if="o.partner_id.vat">
                                <td><strong>NIF :</strong></td>
                                <td><span t-field="o.partner_id.vat"/></td>
                            </tr>
                            <tr t-if="o.partner_id.phone">
                                <td><strong>Tél :</strong></td>
                                <td><span t-field="o.partner_id.phone"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Tableau des soldes -->
                <table class="table table-bordered mt-4">
                    <thead>
                        <tr class="bg-200">
                            <th class="text-center" style="width: 60%;">Désignation</th>
                            <th class="text-center" style="width: 40%;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Ancien Solde</strong></td>
                            <td class="text-right">
                                <span t-field="o.partner_old_balance"
                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Montant Versé</strong></td>
                            <td class="text-right">
                                <span t-field="o.amount"
                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr style="border-top: 2px solid #000;">
                            <td><strong>Solde Final</strong></td>
                            <td class="text-right">
                                <strong>
                                    <span t-field="o.partner_balance"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Signature -->
                <div class="row mt-5">
                    <div class="col-6 text-center">
                        <p><strong>Signature Client</strong></p>
                        <br/><br/>
                        <p>_________________________</p>
                    </div>
                    <div class="col-6 text-center">
                        <p><strong>Signature Société</strong></p>
                        <br/><br/>
                        <p>_________________________</p>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <template id="report_payment_receipt_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="adi_payment_receipt_balance.report_payment_receipt_balance_document" t-lang="lang"/>
            </t>
        </t>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_activite" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.activite</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='default_setting_options']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="activite_required_for_invoice"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="activite_required_for_invoice"/>
                        <div class="text-muted">
                            Exiger que l'activit&#233; du client soit renseign&#233;e avant d'imprimer les factures (avec ou sans paiement)
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

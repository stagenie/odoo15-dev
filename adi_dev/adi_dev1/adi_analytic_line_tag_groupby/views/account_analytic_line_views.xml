<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_analytic_line_filter_tag_groupby" model="ir.ui.view">
        <field name="name">account.analytic.line.select.tag.groupby</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="string">Étiquette analytique</attribute>
            </xpath>
            <xpath expr="//filter[@name='date']" position="after">
                <separator/>
                <filter string="Avec étiquette" name="with_tag" domain="[('tag_ids', '!=', False)]"/>
                <filter string="Sans étiquette" name="without_tag" domain="[('tag_ids', '=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='account_id']" position="after">
                <filter string="Étiquette analytique" name="group_tag_ids" context="{'group_by': 'tag_ids'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_tree_tag_groupby" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.tag.groupby</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Étiquettes</attribute>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stamp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stamp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" string="Cachet et Signature" data-key="adi_invoice_stamp">
                    <h2>Cachet et Signature</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="stamp_show"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="stamp_show"/>
                                <div class="text-muted">
                                    Ajouter automatiquement un cachet ou une signature scannée sur les rapports de factures PDF.
                                </div>
                                <div class="content-group" attrs="{'invisible': [('stamp_show', '=', False)]}">
                                    <div class="row mt16">
                                        <label for="stamp_image" class="col-lg-3 o_light_label"/>
                                        <field name="stamp_image" widget="image" class="oe_avatar"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="stamp_size_mode" class="col-lg-3 o_light_label"/>
                                        <field name="stamp_size_mode"/>
                                    </div>
                                    <div class="row mt8" attrs="{'invisible': [('stamp_size_mode', '!=', 'custom')]}">
                                        <label for="stamp_width" class="col-lg-3 o_light_label"/>
                                        <field name="stamp_width" class="col-lg-2"/>
                                        <span class="ms-1">cm</span>
                                    </div>
                                    <div class="row mt8" attrs="{'invisible': [('stamp_size_mode', '!=', 'custom')]}">
                                        <label for="stamp_height" class="col-lg-3 o_light_label"/>
                                        <field name="stamp_height" class="col-lg-2"/>
                                        <span class="ms-1">cm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

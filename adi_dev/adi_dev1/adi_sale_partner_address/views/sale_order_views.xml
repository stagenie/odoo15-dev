<odoo>
    <!-- Extension de la vue Devis pour afficher l'adresse du client à sa sélection -->
    <record id="view_order_form_partner_address" model="ir.ui.view">
        <field name="name">sale.order.form.partner.address</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ajouter l'adresse client juste après le champ partenaire -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_full_address"
                       attrs="{'invisible': [('partner_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
